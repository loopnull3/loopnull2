+             r->flags & 4 ? " residency" : "", r->flags & 8 ? " sparse" : "", r->flags & 16 ? " dense-capped" : "", r->level, r->w, r->h, r->nb, r->ly0, r->ly0 + r->nly - 1, nzl, zs, nhl, hs, hve, hem, nbl, bs, vp, vx, vi);
