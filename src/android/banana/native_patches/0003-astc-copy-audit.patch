+    if (!b->n && !b->last) return;
+    b->pass = g_cas.pass; b->nimg = (uint32_t)g_cas.n; b->unread = g_cas.unread; b->f0 = g_cas.f0; b->frame = fr;
+    atomic_store(&b->busy, 1);
+    vka_after(fence, ca_scan_done, b);
+}
