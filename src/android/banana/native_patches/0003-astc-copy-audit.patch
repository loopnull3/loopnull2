+            rg[n] = (VkBufferImageCopy){b->mem.off + used + n * per, 0, 0, {VK_IMAGE_ASPECT_COLOR_BIT, i, g_cas.ly, 1}, {0, 0, 0}, {w, h, 1}}; n++; g_cas.ly++; }
+        if (!barrier) { vka_barrier(cb); barrier = 1; }
+        vk.vkCmdCopyImageToBuffer(cb, im->img, VK_IMAGE_LAYOUT_GENERAL, b->mem.buf, n, rg);
+        b->r[b->n++] = (ca_rec){im->serial, (uint32_t)im->d.format, (uint32_t)im->d.width, (uint32_t)im->d.height, im->layers, i + im->base, w, h, ly0, n, bx * by, f->bw, f->bh,
+                                (im->gpu_owned ? 1u : 0) | (im->wt ? 2u : 0) | (im->rs ? 4u : 0) | (im->vtrack ? 8u : 0) | (im->dcap ? 16u : 0), used};
+        used += n * per;
+        if (g_cas.ly >= im->layers) { g_cas.lv++; g_cas.ly = 0; }
+    }
+    pthread_mutex_unlock(&g_tmu);
+    if (g_cas.cur >= g_cas.n) { b->last = 1; g_cas.active = 0; g_cas.next = fr + 600; }
+    if (!b->n && !b->last) return;
+    b->pass = g_cas.pass; b->nimg = (uint32_t)g_cas.n; b->unread = g_cas.unread; b->f0 = g_cas.f0; b->frame = fr;
+    atomic_store(&b->busy, 1);
+    vka_after(fence, ca_scan_report, b);
+}
+// DM_VK_ASTC_CLEAN_COPIES=1 (an experiment, Hokkaido): the bytes a copy brings into an ASTC image go through astc_clean, as an upload from guest storage does
+int vka_astc_copy_clean_on(const vka_img *im) { return is_astc(im->f.vk) && VKA_ENV("DM_VK_ASTC_CLEAN_COPIES", 0) > 0; }
+void vka_astc_copy_clean(const vka_img *im, uint8_t *p, size_t n, const char *what, uint32_t level, uint32_t layer) {
+    unsigned k = (unsigned)(im->f.vk - VK_FORMAT_ASTC_4x4_UNORM_BLOCK); uint32_t c[7] = {0};
+    hk_astc_count(p, n / 16, dims[k / 2][0], dims[k / 2][1], c);
+    astc_clean(im->f.vk, p, n & ~(size_t)15);
+    static _Atomic int lines;
+    if ((c[0] | c[1] | c[2] | c[4] | c[6]) && atomic_fetch_add(&lines, 1) < 400)
+        VLOG("ASTC copy cleaned: %s into serial %llu format %#x level %u layer %u: of %zu blocks %u all-zero, %u HDR void-extent, %u of an HDR endpoint mode, %u no ASTC data, %u void-extent with an illegal extent",
+             what, (unsigned long long)im->serial, im->d.format, level, layer, n / 16, c[0], c[2], c[4], c[1], c[6]);
+}
+// The experiment's buffer → texture copy: nz slices of rows rows (row bytes apart, slices img bytes apart) of the guest buffer at src, as the GPU would read them here, into
+// scratch memory, wb bytes a row, tightly packed, and cleaned. 0 = not known on the CPU (not placed guest RAM, or a GPU write into the range has not landed): the caller
+// copies as before
+int vka_astc_copy_take(const vka_img *im, uint64_t src, uint64_t span, size_t row, size_t img, size_t rows, int nz, size_t wb, VkDeviceSize align, vka_span *s, uint32_t level, uint32_t layer) {
+    int packed = row == wb && img == wb * rows, ok = 0;   // (packed: span is the scratch size)
+    uint8_t *t = packed ? NULL : malloc(span);
+    if (!packed && !t) return 0;
+    nvn_pool_use(1);   // (the buffer's pool is not finalized, and its memory unmapped, under the read)
+    if (vka_addr(src, span, NULL, NULL, NULL) && vka_tex_gw_read(src, span, NULL) && vka_scratch(wb * rows * (size_t)nz, align, s)) ok = vka_tex_gw_read(src, span, t ? t : s->ptr);
+    nvn_pool_use(0);
+    if (ok && t) for (int z = 0; z < nz; z++) for (size_t y = 0; y < rows; y++) memcpy(s->ptr + ((size_t)z * rows + y) * wb, t + (size_t)z * img + y * row, wb);
+    free(t);
+    if (ok) vka_astc_copy_clean(im, s->ptr, wb * rows * (size_t)nz, "buffer → texture", level, layer);
+    return ok;
+}
 #endif
