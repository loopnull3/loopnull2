+             im->gpu_owned ? ", GPU-written" : "", im->track ? ", tracked" : "", im->vtrack ? ", sparse" : "", im->vbind ? ", sparse GPU-written" : "", im->rs ? ", residency image" : "",
+             im->dcap ? ", dense from a coarser level" : "", im->soft ? ", soft" : "", im->wt ? ", WriteTexels" : "", im->par ? ", a level child" : "");
+}
+static void ca_layers(const uint64_t b[2], char *o, size_t n) {   // "0-4,7,9-67"
+    size_t at = 0; o[0] = 0;
+    for (int i = 0; i < 128 && at + 12 < n; i++) {
+        if (!(b[i >> 6] >> (i & 63) & 1)) continue;
+        int j = i; while (j + 1 < 128 && (b[(j + 1) >> 6] >> ((j + 1) & 63) & 1)) j++;
