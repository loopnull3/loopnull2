+// The levels of a block-compressed image, from its first, that a view of it as an uncompressed format of one texel a block reaches as its own levels. RADV copies into
+// and out of a compressed image through such a view. The view's level L has the first level's block count halved L times, which is fewer blocks than the level has when
+// a size is no power of two (1024x384 texels of 8x8 blocks: 48 block rows, level 5 has 2 and 48 >> 5 is 1). RADV then widens the view, as far as the first level's
+// padding goes (taken as to 16 blocks, the least the copy audit's measurements allow), and past that takes addrlib's non-block-compressed view. → the first level that
+// needs that view, or the image's level count when none does
+uint32_t vka_block_reach(uint32_t w, uint32_t h, uint32_t bw, uint32_t bh, uint32_t levels) {
+    for (uint32_t i = 1; i < levels; i++) for (int k = 0; k < 2; k++) {
+        uint32_t d = k ? h : w, b = k ? bh : bw, base = (d + b - 1) / b, pad = (base + 15) & ~15u, lv = d >> i ? d >> i : 1, need = (lv + b - 1) / b;
+        uint64_t ext = (uint64_t)need << i; if (ext < base) ext = base; if (ext > pad) ext = pad;
+        if ((ext >> i ? ext >> i : 1) < need) return i;
+    }
+    return levels;
