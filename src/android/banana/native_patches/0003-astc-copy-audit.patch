diff --git a/dm/gfx/vk_android/vka_nanscan.c b/dm/gfx/vk_android/vka_nanscan.c
index 44d32b05..88869842 100644
--- a/dm/gfx/vk_android/vka_nanscan.c
+++ b/dm/gfx/vk_android/vka_nanscan.c
@@ -128,6 +128,185 @@ static void astc_check(VkCommandBuffer cb) {
     vka_barrier(cb);
     g_astc_state = 1;
 }
+// The copy audit's ASTC check (DM_VK_COPY_AUDIT, vka_tex.c; once a run): twelve blocks of a 16x12 ASTC 4x4 texture as the device samples them, logged when fence is
+// done. The blocks reach the image as they are (a copy after the texture's own, cleaned upload): the kinds an upload takes out, and void-extent blocks with an extent.
+// The scan then finds in it 1 all-zero block, 2 HDR ones (1 void-extent), 1 that is no ASTC data, and LDR void-extent blocks: 4 without an extent, 1 with, 2 illegal
+int hk_astc_probe_blocks(uint8_t out[2][16], float first[2][4]);   // vka_astc_hdr.cpp
+static struct { vka_span out; float exp[12][4]; int know[12]; const char *what[12]; } g_pr;   // know: 1 = exp is what a decoder reads, 2 = exp is the block's colour
+static void probe_report(void *arg) {
+    (void)arg; const float *t = (const float *)g_pr.out.ptr;
+    for (int b = 0; b < 12; b++) {
+        if (!g_pr.what[b]) continue;
+        const float *v = t + 4 * ((b / 4) * 4 * 16 + (b % 4) * 4);   // the block's first texel in the 16x12 texture
+        int err = v[0] > 0.99f && v[1] < 0.01f && v[2] > 0.99f && v[3] > 0.99f; char e[96] = "";
+        if (g_pr.know[b]) snprintf(e, sizeof e, "; %s (%.3f, %.3f, %.3f, %.3f)", g_pr.know[b] == 1 ? "a decoder of the full profile reads" : "its colour is", g_pr.exp[b][0], g_pr.exp[b][1], g_pr.exp[b][2], g_pr.exp[b][3]);
+        VLOG("copy audit: ASTC check: %s samples as (%.3f, %.3f, %.3f, %.3f)%s%s", g_pr.what[b], v[0], v[1], v[2], v[3], err ? ": the error colour" : "", e);
+    }
+}
+static void probe_ve(uint8_t *b, int hdr, int rsv, uint32_t s0, uint32_t s1, uint32_t t0, uint32_t t1, const uint16_t c[4]) {   // a void-extent block
+    uint64_t lo = 0x1fc | (uint64_t)hdr << 9 | (uint64_t)rsv << 10 | (uint64_t)s0 << 12 | (uint64_t)s1 << 25 | (uint64_t)t0 << 38 | (uint64_t)t1 << 51, hi = 0;
+    for (int k = 0; k < 4; k++) hi |= (uint64_t)c[k] << (16 * k);
+    memcpy(b, &lo, 8); memcpy(b + 8, &hi, 8);
+}
+void vka_astc_probe(VkCommandBuffer cb, uint64_t fence) {
+    static int done; if (done) return;
+    done = 1;
+    static uint8_t blk[12][16]; static tex_t t; vka_span raw;
+    if (!V.push_desc || !ready() || !vka_static(sizeof blk, 16, &raw) || !vka_static(192 * 16, V.sb_align, &g_pr.out)) { VLOG("copy audit: ASTC check: not run (push descriptors or memory)"); return; }
+    static const uint16_t C[4] = {0x8000, 0x4000, 0xc000, 0xffff}, H[4] = {0x3800, 0x3400, 0x3a00, 0x3c00}, Z[4] = {0, 0, 0, 0};
+    static const float ec[4] = {0.5f, 0.25f, 0.75f, 1.0f};
+    memset(blk, 0, sizeof blk);
+    probe_ve(blk[0], 0, 3, 0x1fff, 0x1fff, 0x1fff, 0x1fff, C); g_pr.what[0] = "an LDR void-extent block without an extent";
+    probe_ve(blk[1], 0, 3, 0, 0, 0, 0, C); g_pr.what[1] = "an LDR void-extent block whose extent is all zero (illegal)";
+    probe_ve(blk[2], 0, 3, 0, 0x1000, 0, 0x1000, C); g_pr.what[2] = "an LDR void-extent block with a legal extent";
+    probe_ve(blk[3], 0, 3, 0x1000, 0x800, 0, 0x1000, C); g_pr.what[3] = "an LDR void-extent block whose extent has low above high (illegal)";
+    g_pr.what[4] = "an all-zero block";
+    probe_ve(blk[5], 1, 3, 0x1fff, 0x1fff, 0x1fff, 0x1fff, H); g_pr.what[5] = "an HDR void-extent block";
+    probe_ve(blk[6], 0, 0, 0x1fff, 0x1fff, 0x1fff, 0x1fff, C); g_pr.what[6] = "a void-extent block with its reserved bits clear (illegal)";
+    probe_ve(blk[7], 0, 3, 0x1fff, 0x1fff, 0x1fff, 0x1fff, Z); g_pr.what[7] = "the zero texels an upload makes (an LDR void-extent block of 0)";
+    for (int b = 0; b < 7; b++) if (b != 4) { memcpy(g_pr.exp[b], ec, sizeof ec); g_pr.know[b] = b == 1 || b == 3 || b == 6 ? 2 : 1; }   // (the illegal ones: an error block by the specification)
+    uint8_t two[2][16]; float first[2][4]; int pr = hk_astc_probe_blocks(two, first);
+    if (pr & 1) { memcpy(blk[8], two[0], 16); memcpy(g_pr.exp[8], first[0], sizeof first[0]); g_pr.know[8] = 1; g_pr.what[8] = "a block of LDR endpoint modes"; }
+    if (pr & 2) { memcpy(blk[9], two[1], 16); memcpy(g_pr.exp[9], first[1], sizeof first[1]); g_pr.know[9] = 1; g_pr.what[9] = "a block of an HDR endpoint mode"; }
+    for (int b = 8; b < 12; b++) if (!g_pr.what[b]) memcpy(blk[b], blk[7], 16);
+    memset(&t, 0, sizeof t);
+    t.d.target = NVN_TEXTURE_TARGET_2D; t.d.format = 0x79; t.d.width = 16; t.d.height = 12; t.d.depth = 1; t.d.levels = 1; t.d.flags = NVN_TEXTURE_FLAGS_LINEAR; t.d.stride = 64;
+    nvn_tex_layout(&t.d, &t.L); t.mem = (uint8_t *)blk; t.serial = nvn_new_serial();
+    vka_img *im = vka_tex_get(&t, cb);
+    if (!im) { VLOG("copy audit: ASTC check: no test texture"); return; }
+    memcpy(raw.ptr, blk, sizeof blk); memset(g_pr.out.ptr, 0, 192 * 16);
+    vka_tex_own(im, cb); vka_barrier(cb);
+    VkBufferImageCopy rg = {raw.off, 0, 0, {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1}, {0, 0, 0}, {16, 12, 1}};
+    vk.vkCmdCopyBufferToImage(cb, raw.buf, im->img, VK_IMAGE_LAYOUT_GENERAL, 1, &rg);
+    vka_img_written(im);   // (GPU-written: the audit's scan counts its blocks too, which checks the scan against a known texture)
+    vka_barrier(cb);
+    VkImageView v = vka_view(im, im->f.view, VK_IMAGE_VIEW_TYPE_2D_ARRAY, VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1, NULL);
+    if (!v) return;
+    VkDescriptorImageInfo ii = {vka_samp_default(), v, VK_IMAGE_LAYOUT_GENERAL};
+    VkDescriptorBufferInfo bi = {g_pr.out.buf, g_pr.out.off, 192 * 16};
+    VkWriteDescriptorSet wr[2] = {{VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, .dstBinding = 0, .descriptorCount = 1, .descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, .pImageInfo = &ii},
+                                  {VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, .dstBinding = 1, .descriptorCount = 1, .descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, .pBufferInfo = &bi}};
+    uint32_t pc[4] = {16, 12, 0, 0};
+    vk.vkCmdBindPipeline(cb, VK_PIPELINE_BIND_POINT_COMPUTE, g_fetch);
+    vk.vkCmdPushDescriptorSetKHR(cb, VK_PIPELINE_BIND_POINT_COMPUTE, g_lay, 0, 2, wr); vka_dyn_invalidate();
+    vk.vkCmdPushConstants(cb, g_lay, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof pc, pc);
+    vk.vkCmdDispatch(cb, 2, 2, 1);
+    vka_barrier(cb);
+    vka_after(fence, probe_report, NULL);
+}
+// The copy audit's mip check (once a run): small mip-mapped textures of block-compressed formats, each with a known block per level, layer and place. One is filled as an
+// upload fills a texture (vkCmdCopyBufferToImage, a level and layer a call), a second by copies from it as a game's are (vkCmdCopyImage, a level and layer a call); then
+// every level and layer of both is sampled (the block's first texel) and copied out (its bytes), and the lines say per level how many blocks came back right each way.
+// Sizes that are no power of two are there for the levels a driver cannot reach by halving the first level's block count: RADV views a compressed image as an
+// uncompressed one of its blocks to copy into or out of it, and a level of 42 texels has 6 blocks of 8 where half of the 11 blocks of 85 texels is 5
+enum { MP_REC = 640, MP_OUT = 8 << 20, MP_BLK = 512 << 10, MP_STORE = 2 << 20 };
+typedef struct { int fmt; uint32_t bw, bh, w, h, layers, levels; const char *name; } mp_shape;
+static const mp_shape g_mps[] = {
+    {0x80, 8, 8, 128, 128, 1, 8, "ASTC 8x8"}, {0x80, 8, 8, 85, 128, 4, 4, "ASTC 8x8"}, {0x80, 8, 8, 85, 128, 1, 8, "ASTC 8x8"}, {0x80, 8, 8, 119, 128, 1, 8, "ASTC 8x8"},
+    {0x80, 8, 8, 128, 48, 4, 6, "ASTC 8x8"}, {0x80, 8, 8, 104, 127, 1, 7, "ASTC 8x8"}, {0x79, 4, 4, 85, 128, 1, 8, "ASTC 4x4"}, {0x44, 4, 4, 85, 128, 1, 8, "BC3"},
+};
+enum { MP_N = sizeof g_mps / sizeof *g_mps };
+typedef struct { uint8_t shape, img, level, layer; uint32_t w, h, bx, by; VkDeviceSize samp, rb; } mp_rec;   // samp: its texels in out (a vec4 each); rb: its blocks read back
+static struct { vka_span out, up, rb; mp_rec r[MP_REC]; int n; } g_mp;
+// The block at (x, y) of a level and layer, and the colour its texels have
+static void mp_block(const mp_shape *s, uint32_t level, uint32_t layer, uint32_t x, uint32_t y, uint8_t b[16], float e[4]) {
+    if (s->fmt == 0x44) {   // BC3: both alphas and both colours (RGB565) the same, every index 0
+        uint32_t a = 255 - 16 * layer, r5 = (2 * level + 1) & 31, g6 = (4 * (x & 15) + 2) & 63, b5 = (2 * (y & 15) + 1) & 31; uint16_t c = (uint16_t)(r5 << 11 | g6 << 5 | b5);
+        memset(b, 0, 16); b[0] = b[1] = (uint8_t)a; memcpy(b + 8, &c, 2); memcpy(b + 10, &c, 2);
+        e[0] = (float)(r5 << 3 | r5 >> 2) / 255.0f; e[1] = (float)(g6 << 2 | g6 >> 4) / 255.0f; e[2] = (float)(b5 << 3 | b5 >> 2) / 255.0f; e[3] = (float)a / 255.0f;
+        return;
+    }
+    const uint16_t c[4] = {(uint16_t)(0x2000 + 0x1000 * level), (uint16_t)(0x0800 + 0x0f00 * (x & 15)), (uint16_t)(0x0800 + 0x0f00 * (y & 15)), (uint16_t)(0xffff - 0x1000 * layer)};
+    probe_ve(b, 0, 3, 0x1fff, 0x1fff, 0x1fff, 0x1fff, c);   // an LDR void-extent block without an extent: the check above samples those right
+    for (int k = 0; k < 4; k++) e[k] = (float)c[k] / 65535.0f;
+}
+static void mp_report(void *arg) {
+    (void)arg;
+    for (unsigned si = 0; si < MP_N; si++) {
+        const mp_shape *s = &g_mps[si]; uint32_t bx0 = (s->w + s->bw - 1) / s->bw, by0 = (s->h + s->bh - 1) / s->bh;
+        for (uint32_t lv = 0; lv < s->levels; lv++) {
+            uint32_t tot[2] = {0, 0}, sok[2] = {0, 0}, serr[2] = {0, 0}, rok[2] = {0, 0}, w = 0, h = 0, bx = 0, by = 0; char first[2][200] = {"", ""};
+            for (int i = 0; i < g_mp.n; i++) {
+                const mp_rec *r = &g_mp.r[i]; if (r->shape != si || r->level != lv) continue;
+                const float *t = (const float *)(g_mp.out.ptr + r->samp); const uint8_t *rb = g_mp.rb.ptr + r->rb; w = r->w; h = r->h; bx = r->bx; by = r->by;
+                for (uint32_t y = 0; y < r->by; y++) for (uint32_t x = 0; x < r->bx; x++) {
+                    uint8_t b[16]; float e[4]; mp_block(s, lv, r->layer, x, y, b, e);
+                    const float *v = t + 4 * ((size_t)(y * s->bh) * r->w + x * s->bw); int ok = 1;
+                    for (int k = 0; k < 4; k++) { float d = v[k] - e[k]; if (d < -0.012f || d > 0.012f) ok = 0; }
+                    tot[r->img]++; sok[r->img] += (uint32_t)ok; serr[r->img] += !ok && v[0] > 0.99f && v[1] < 0.01f && v[2] > 0.99f && v[3] > 0.99f;
+                    rok[r->img] += !memcmp(rb + 16 * ((size_t)y * r->bx + x), b, 16);
+                    if (!ok && !first[r->img][0]) snprintf(first[r->img], sizeof first[0], " (first wrong: layer %u block %u,%u samples (%.3f, %.3f, %.3f, %.3f), has (%.3f, %.3f, %.3f, %.3f))",
+                                                           r->layer, x, y, v[0], v[1], v[2], v[3], e[0], e[1], e[2], e[3]);
+                }
+            }
+            if (!tot[0] && !tot[1]) continue;
+            int halves = (bx0 >> lv ? bx0 >> lv : 1) >= bx && (by0 >> lv ? by0 >> lv : 1) >= by;
+            VLOG("copy audit: mip check: %s %ux%u x%u level %u (%ux%u, %ux%u blocks%s): uploaded: %u of %u blocks sample right, %u as the error colour, %u read back right%s; copied from it: %u of %u sample right, %u as the error colour, %u read back right%s",
+                 s->name, s->w, s->h, s->layers, lv, w, h, bx, by, halves ? "" : ", more than the first level's halved", sok[0], tot[0], serr[0], rok[0], first[0], sok[1], tot[1], serr[1], rok[1], first[1]);
+        }
+    }
+}
+void vka_astc_mip_probe(VkCommandBuffer cb, uint64_t fence) {
+    static int done; if (done) return;
+    done = 1;
+    static uint8_t store[MP_STORE]; static tex_t tx[2 * MP_N]; size_t so = 0;   // (the textures' storage: zeros; their content is the copies below)
+    if (!V.push_desc || !ready() || !vka_static(MP_OUT, V.sb_align, &g_mp.out) || !vka_static(MP_BLK, 16, &g_mp.up) || !vka_static(MP_BLK, 16, &g_mp.rb)) { VLOG("copy audit: mip check: not run (push descriptors or memory)"); return; }
+    memset(g_mp.out.ptr, 0, MP_OUT); memset(g_mp.rb.ptr, 0, MP_BLK);
+    VkDeviceSize uo = 0, oo = 0, ro = 0, al = V.sb_align > 16 ? V.sb_align : 16;
+    for (unsigned si = 0; si < MP_N; si++) {
+        const mp_shape *s = &g_mps[si]; vka_img *ims[2] = {NULL, NULL}; int ok = 1;
+        for (int k = 0; k < 2 && ok; k++) {
+            tex_t *t = &tx[2 * si + k]; memset(t, 0, sizeof *t);
+            t->d.target = s->layers > 1 ? NVN_TEXTURE_TARGET_2D_ARRAY : NVN_TEXTURE_TARGET_2D; t->d.format = s->fmt; t->d.width = s->w; t->d.height = s->h; t->d.depth = s->layers; t->d.levels = s->levels;
+            nvn_tex_layout(&t->d, &t->L);
+            size_t need = ((size_t)t->L.size + 4095) & ~(size_t)4095;
+            if (!t->L.size || so + need > MP_STORE) { ok = 0; break; }
+            t->mem = store + so; so += need; t->serial = nvn_new_serial();
+            ims[k] = vka_tex_get(t, cb);
+            ok = ims[k] && ims[k]->levels == s->levels && ims[k]->layers == s->layers && !ims[k]->base && ims[k]->w == s->w && ims[k]->h == s->h;
+        }
+        if (!ok) { VLOG("copy audit: mip check: %s %ux%u x%u: no test texture", s->name, s->w, s->h, s->layers); continue; }
+        vka_tex_own(ims[0], cb); vka_tex_own(ims[1], cb); vka_barrier(cb);
+        for (uint32_t lv = 0; lv < s->levels; lv++) for (uint32_t ly = 0; ly < s->layers; ly++) {   // as an upload
+            uint32_t w = s->w >> lv ? s->w >> lv : 1, h = s->h >> lv ? s->h >> lv : 1, bx = (w + s->bw - 1) / s->bw, by = (h + s->bh - 1) / s->bh;
+            if (uo + (VkDeviceSize)bx * by * 16 > MP_BLK) continue;
+            for (uint32_t y = 0; y < by; y++) for (uint32_t x = 0; x < bx; x++) { float e[4]; mp_block(s, lv, ly, x, y, g_mp.up.ptr + uo + 16 * ((size_t)y * bx + x), e); }
+            VkBufferImageCopy rg = {g_mp.up.off + uo, 0, 0, {VK_IMAGE_ASPECT_COLOR_BIT, lv, ly, 1}, {0, 0, 0}, {w, h, 1}};
+            vk.vkCmdCopyBufferToImage(cb, g_mp.up.buf, ims[0]->img, VK_IMAGE_LAYOUT_GENERAL, 1, &rg);
+            uo += (VkDeviceSize)bx * by * 16;
+        }
+        vka_img_written(ims[0]); vka_barrier(cb);
+        for (uint32_t lv = 0; lv < s->levels; lv++) for (uint32_t ly = 0; ly < s->layers; ly++) {   // as a game's copy
+            uint32_t w = s->w >> lv ? s->w >> lv : 1, h = s->h >> lv ? s->h >> lv : 1;
+            VkImageCopy r = {{VK_IMAGE_ASPECT_COLOR_BIT, lv, ly, 1}, {0, 0, 0}, {VK_IMAGE_ASPECT_COLOR_BIT, lv, ly, 1}, {0, 0, 0}, {w, h, 1}};
+            vk.vkCmdCopyImage(cb, ims[0]->img, VK_IMAGE_LAYOUT_GENERAL, ims[1]->img, VK_IMAGE_LAYOUT_GENERAL, 1, &r);
+        }
+        vka_img_written(ims[1]); vka_barrier(cb);
+        for (int k = 0; k < 2; k++) for (uint32_t lv = 0; lv < s->levels; lv++) for (uint32_t ly = 0; ly < s->layers; ly++) {
+            uint32_t w = s->w >> lv ? s->w >> lv : 1, h = s->h >> lv ? s->h >> lv : 1, bx = (w + s->bw - 1) / s->bw, by = (h + s->bh - 1) / s->bh;
+            VkDeviceSize sn = (VkDeviceSize)w * h * 16, bn = (VkDeviceSize)bx * by * 16;
+            if (g_mp.n == MP_REC || oo + sn > MP_OUT || ro + bn > MP_BLK) continue;
+            VkImageView v = vka_view(ims[k], ims[k]->f.view, VK_IMAGE_VIEW_TYPE_2D_ARRAY, VK_IMAGE_ASPECT_COLOR_BIT, lv, 1, ly, 1, NULL);
+            if (!v) continue;
+            VkDescriptorImageInfo ii = {vka_samp_default(), v, VK_IMAGE_LAYOUT_GENERAL};
+            VkDescriptorBufferInfo bi = {g_mp.out.buf, g_mp.out.off + oo, sn};
+            VkWriteDescriptorSet wr[2] = {{VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, .dstBinding = 0, .descriptorCount = 1, .descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, .pImageInfo = &ii},
+                                          {VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, .dstBinding = 1, .descriptorCount = 1, .descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, .pBufferInfo = &bi}};
+            uint32_t pc[4] = {w, h, 0, 0};
+            vk.vkCmdBindPipeline(cb, VK_PIPELINE_BIND_POINT_COMPUTE, g_fetch);
+            vk.vkCmdPushDescriptorSetKHR(cb, VK_PIPELINE_BIND_POINT_COMPUTE, g_lay, 0, 2, wr);
+            vk.vkCmdPushConstants(cb, g_lay, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof pc, pc);
+            vk.vkCmdDispatch(cb, (w + 7) / 8, (h + 7) / 8, 1);
+            VkBufferImageCopy rg = {g_mp.rb.off + ro, 0, 0, {VK_IMAGE_ASPECT_COLOR_BIT, lv, ly, 1}, {0, 0, 0}, {w, h, 1}};
+            vk.vkCmdCopyImageToBuffer(cb, ims[k]->img, VK_IMAGE_LAYOUT_GENERAL, g_mp.rb.buf, 1, &rg);
+            g_mp.r[g_mp.n++] = (mp_rec){(uint8_t)si, (uint8_t)k, (uint8_t)lv, (uint8_t)ly, w, h, bx, by, oo, ro};
+            oo = (oo + sn + al - 1) / al * al; ro += bn;
+        }
+        vka_barrier(cb);
+    }
+    vka_dyn_invalidate();
+    vka_after(fence, mp_report, NULL);
+}
 // One dispatch: level lv, layer l0 of im into the batch's next result
