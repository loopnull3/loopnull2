+            uint32_t hdr = c[2] + c[4]; hve += c[2]; hem += c[4]; vp += c[3]; vx += c[5]; vi += c[6];
+            sig = (sig ^ (c[0] | (uint64_t)c[1] << 20 | (uint64_t)hdr << 40)) * 1099511628211ull; sig = (sig ^ (c[5] | (uint64_t)c[6] << 32)) * 1099511628211ull;
