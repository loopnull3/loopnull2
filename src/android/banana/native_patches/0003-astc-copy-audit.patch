+static const char *const ca_kinds[] = {"texture → texture", "texture → texture, dropped (a level its image does not hold)", "texture → texture, as a blit", "buffer → texture",
+                                       "buffer → texture, read and cleaned on the CPU", "WriteTexels", "WriteTexels, cleaned"};
