+    if (!g_caw_up) { pthread_t th; if (pthread_create(&th, NULL, ca_worker, NULL)) { g_cas.active = 0; g_cas.next = UINT64_MAX; VRED("copy audit: no thread for the scan"); return; } pthread_detach(th); g_caw_up = 1; }
