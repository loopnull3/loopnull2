+// ---------- Copy audit (DM_VK_COPY_AUDIT, Hokkaido) ----------
+// A diagnostic for the ASTC blocks this driver draws as the error colour, magenta (all-zero blocks, HDR blocks, blocks that are no ASTC data): an upload from guest storage
+// takes them out (astc_clean), a copy does not. Where they come from and where they are:
+// 1. Every copy with an ASTC texture on either side (texture → texture, buffer → texture, WriteTexels) is logged once per kind, textures and levels, and each image's
+//    state once; every 900 frames, how many copies each of those took since and the destination layers they wrote.
+// 2. A scan, every 600 frames: each ASTC image the GPU wrote, the game writes through WriteTexels, that is sparse or that a copy read has its levels of at most 256 KiB a
+//    layer copied out of the image (CA_ARENA a submission) and, once the submission is done, counted by their headers (hk_astc_count). A level is logged when its counts
+//    change; DM_VK_COPY_AUDIT_LINES (default 4000) bounds those lines. Not for play: the counting runs on the completion thread
+enum { CA_KEYS = 4096, CA_SRC = 256, CA_SET = 160, CA_TOLD = 512, CA_BATCH = 6, CA_REC = 192, CA_ARENA = 3 << 20, CA_LAYER_MAX = 256 << 10, CA_SEEN = 4096 };
+typedef struct { uint64_t ss, ds, n, n_rep, lay[2], lay_rep[2]; uint32_t sl, dl; uint8_t kind, dirty; } ca_key;
+static ca_key g_cak[CA_KEYS]; static int g_ncak;
+static uint64_t g_ca_src[CA_SRC]; static int g_nca_src;   // ASTC textures a copy read: scanned too (replay thread)
+static const char *const ca_kinds[] = {"texture → texture", "texture → texture, dropped (a level its image does not hold)", "texture → texture, as a blit", "buffer → texture",
+                                       "texture → texture, from the source's storage", "WriteTexels"};
+void hk_astc_count(const uint8_t *data, size_t n, unsigned bw, unsigned bh, uint32_t out[7]);   // vka_astc_hdr.cpp
+int vka_caud_on(void) { return VKA_ENV("DM_VK_COPY_AUDIT", 0) > 0; }
+static void ca_state(const vka_img *im, char *o, size_t n) {
+    snprintf(o, n, "serial %llu format %#x %ux%ux%u, image levels %u+%u%s%s%s%s%s%s%s%s%s", (unsigned long long)im->serial, im->d.format, im->d.width, im->d.height, im->layers, im->base, im->levels,
+             im->gpu_owned ? ", GPU-written" : "", im->track ? ", tracked" : "", im->vtrack ? ", sparse" : "", im->vbind ? ", sparse GPU-written" : "", im->rs ? ", residency image" : "",
+             im->dcap ? ", dense from a coarser level" : "", im->soft ? ", soft" : "", im->wt ? ", WriteTexels" : "", im->par ? ", a level child" : "");
+}
+static void ca_layers(const uint64_t b[2], char *o, size_t n) {   // "0-4,7,9-67"
+    size_t at = 0; o[0] = 0;
+    for (int i = 0; i < 128 && at + 12 < n; i++) {
+        if (!(b[i >> 6] >> (i & 63) & 1)) continue;
+        int j = i; while (j + 1 < 128 && (b[(j + 1) >> 6] >> ((j + 1) & 63) & 1)) j++;
+        at += (size_t)snprintf(o + at, n - at, j > i ? "%s%d-%d" : "%s%d", at ? "," : "", i, j);
+        i = j;
+    }
+    if (!at) snprintf(o, n, "none");
+}
+static void ca_tell(const vka_img *im, const char *what) {   // an image's state, once (replay thread)
+    static uint64_t told[CA_TOLD]; static int n;
+    for (int i = 0; i < n; i++) if (told[i] == im->serial) return;
+    if (n == CA_TOLD) return;
+    told[n++] = im->serial; char a[340]; ca_state(im, a, sizeof a);
+    VLOG("copy audit: frame %llu: %s: %s", (unsigned long long)vka_frame(), what, a);
+}
+// A copy the replay records (replay thread; s NULL: from a buffer or WriteTexels). sl, dl: texture levels; sz, dz: first layers; nz: layers; the source's and the
+// destination's offsets and the region's size
+void vka_caud_copy(int kind, const vka_img *s, const vka_img *d, uint32_t sl, uint32_t dl, uint32_t sz, uint32_t dz, uint32_t nz, int sx, int sy, int dx, int dy, int w, int h) {
+    if (!d || (!is_astc(d->f.vk) && !(s && is_astc(s->f.vk)))) return;
+    uint64_t ss = s ? s->serial : 0;
+    if (s && is_astc(s->f.vk)) {
+        int i = 0; while (i < g_nca_src && g_ca_src[i] != ss) i++;
+        if (i == g_nca_src && g_nca_src < CA_SRC) g_ca_src[g_nca_src++] = ss;
+    }
+    ca_key *k = NULL;
+    for (int i = 0; i < g_ncak; i++) if (g_cak[i].kind == kind && g_cak[i].ss == ss && g_cak[i].ds == d->serial && g_cak[i].sl == sl && g_cak[i].dl == dl) { k = &g_cak[i]; break; }
+    if (!k) {
+        if (g_ncak == CA_KEYS) { VRED_ONCE("copy audit: more than %d kinds of copies: the later ones are not logged", CA_KEYS); return; }
+        k = &g_cak[g_ncak++]; *k = (ca_key){.ss = ss, .ds = d->serial, .sl = sl, .dl = dl, .kind = (uint8_t)kind};
+        if (s) ca_tell(s, "a copy's source");
+        ca_tell(d, "a copy's destination");
+        char a[96] = ""; if (s) snprintf(a, sizeof a, "serial %llu level %u layer %u at %d,%d → ", (unsigned long long)ss, sl, sz, sx, sy);
+        VLOG("copy audit: frame %llu: %s: %sserial %llu level %u layer %u at %d,%d: %dx%d texels, %u layers", (unsigned long long)vka_frame(), ca_kinds[kind], a, (unsigned long long)d->serial,
+             dl, dz, dx, dy, w, h, nz);
+    }
+    k->n++; k->dirty = 1;
+    for (uint32_t z = dz; z < dz + nz && z < 128; z++) { k->lay[z >> 6] |= 1ull << (z & 63); k->lay_rep[z >> 6] |= 1ull << (z & 63); }
+}
+static void ca_copies_report(uint64_t fr) {
+    static uint64_t next; if (fr < next) return;
+    next = fr + 900;
+    for (int i = 0, lines = 0; i < g_ncak && lines < 80; i++) {
+        ca_key *k = &g_cak[i]; if (!k->dirty) continue;
+        char now[200], all[200], src[64] = ""; ca_layers(k->lay_rep, now, sizeof now); ca_layers(k->lay, all, sizeof all);
+        if (k->ss) snprintf(src, sizeof src, "serial %llu level %u → ", (unsigned long long)k->ss, k->sl);
+        VLOG("copy audit: to frame %llu: %s: %sserial %llu level %u: %llu copies (%llu since the last report) into layers %s (so far %s)", (unsigned long long)fr, ca_kinds[k->kind], src,
+             (unsigned long long)k->ds, k->dl, (unsigned long long)k->n, (unsigned long long)(k->n - k->n_rep), now, all);
+        k->n_rep = k->n; k->lay_rep[0] = k->lay_rep[1] = 0; k->dirty = 0; lines++;
+    }
+}
+// The scan. A batch is one submission's part of it: the levels copied out, read when its fence is done
+typedef struct { uint64_t serial; uint32_t fmt, tw, th, layers, level, w, h, ly0, nly, nb, bw, bh, flags; VkDeviceSize off; } ca_rec;   // nb: blocks a layer; level: the texture's
+typedef struct { ca_rec r[CA_REC]; int n, have, last; _Atomic int busy; vka_span mem; uint32_t pass, nimg, unread; uint64_t f0, frame; } ca_batch;
+static ca_batch g_cab[CA_BATCH];
+static struct { uint64_t ser[CA_SET], next, f0; int n, cur, active; uint32_t lv, ly, pass, unread; } g_cas;   // (replay thread)
+static pthread_mutex_t g_camu = PTHREAD_MUTEX_INITIALIZER;
+static struct { uint64_t serial, sig; uint32_t level, ly0; } g_caseen[CA_SEEN]; static int g_ncaseen;   // under g_camu, as g_cap
+static struct { uint32_t pass; uint64_t lay, bytes, zl, hl, bl; } g_cap;
+static _Atomic int g_ca_lines;
+static int ca_scanned(const vka_img *im) {   // caller holds g_tmu
+    if (!im->img || !is_astc(im->f.vk) || im->par || im->samples > 1 || im->depth > 1 || im->d.target == NVN_TEXTURE_TARGET_3D || !(im->usage & VK_IMAGE_USAGE_TRANSFER_SRC_BIT)) return 0;
+    if (im->gpu_owned || im->wt || im->rs || im->vtrack || im->dcap) return 1;
+    for (int i = 0; i < g_nca_src; i++) if (g_ca_src[i] == im->serial) return 1;
+    return 0;
+}
+static int ca_bound(vka_img *im, uint32_t i, uint32_t ly, uint32_t h) {   // a residency image's tiled level: every tile of the layer has memory
+    if (!im->rs || i >= vks_tiled(im->rs)) return 1;
+    uint32_t ntx = rs_ntx(im, i), nty = (h + im->rs_th - 1) / im->rs_th;
+    for (uint32_t ty = 0; ty < nty; ty++) for (uint32_t tx = 0; tx < ntx; tx++) if (!vks_tile_bound(im->rs, i, ly, tx, ty)) return 0;
+    return 1;
+}
+static void ca_scan_report(void *arg) {
+    ca_batch *b = arg;
+    pthread_mutex_lock(&g_camu);
+    if (g_cap.pass != b->pass) { memset(&g_cap, 0, sizeof g_cap); g_cap.pass = b->pass; }
+    for (int k = 0; k < b->n; k++) {
+        const ca_rec *r = &b->r[k];
+        static const uint8_t unrun[16] = {0xA5, 0xA5, 0xA5, 0xA5, 0xA5, 0xA5, 0xA5, 0xA5, 0xA5, 0xA5, 0xA5, 0xA5, 0xA5, 0xA5, 0xA5, 0xA5};
