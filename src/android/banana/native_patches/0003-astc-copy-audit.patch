+// Before a submission ends (replay thread): the copies' report, and the scan's next part recorded into cb, read when fence is done
+void vka_caud_scan(VkCommandBuffer cb, uint64_t fence) {
+    if (!vka_caud_on() || !cb) return;
+    uint64_t fr = vka_frame();
+    vka_astc_probe(cb, fence);   // (once: how this device samples the blocks counted below)
+    if (fr >= 2) vka_astc_mip_probe(cb, fence);   // (once, in a later submission: whether it writes and samples every level of a mip-mapped texture alike)
+    ca_copies_report(fr);
+    if (!g_cas.active) {
+        if (fr < g_cas.next) return;
+        pthread_mutex_lock(&g_tmu);
+        g_cas.n = 0;
+        for (int pass = 0; pass < 2; pass++) for (int i = 0; i < g_nlive && g_cas.n < CA_SET; i++) {   // the images copies or WriteTexels wrote and the sparse ones first, then the copies' sources
+            const vka_img *im = g_live[i]; int own = im->gpu_owned || im->wt || im->rs || im->vtrack || im->dcap;
+            if (!ca_scanned(im) || own != !pass) continue;
+            g_cas.ser[g_cas.n++] = im->serial; ca_tell(im, "scanned");
+        }
+        pthread_mutex_unlock(&g_tmu);
+        g_cas.next = fr + 600;
+        if (!g_cas.n) return;
+        g_cas.active = 1; g_cas.cur = 0; g_cas.lv = g_cas.ly = 0; g_cas.unread = 0; g_cas.pass++; g_cas.f0 = fr;
+    }
+    ca_batch *b = NULL;
+    for (int i = 0; i < CA_BATCH && !b; i++) if (!atomic_load(&g_cab[i].busy)) b = &g_cab[i];
+    if (!b) return;   // (every batch waits for its submission: the next one goes on)
+    if (!b->have) { if (!vka_static(CA_ARENA, 16, &b->mem)) { g_cas.active = 0; g_cas.next = UINT64_MAX; VRED("copy audit: no memory for the scan"); return; } b->have = 1; }
+    b->n = 0; b->last = 0; VkDeviceSize used = 0; int barrier = 0;
+    pthread_mutex_lock(&g_tmu);
+    while (g_cas.cur < g_cas.n && b->n < CA_REC) {
+        smap_ent *e = map_get(g_cas.ser[g_cas.cur]); vka_img *im = e ? e->im : NULL;
+        if (!im || !ca_scanned(im) || g_cas.lv >= im->levels) { g_cas.cur++; g_cas.lv = g_cas.ly = 0; continue; }
+        const vka_fmt *f = &im->f; uint32_t i = g_cas.lv, w = im->w >> i ? im->w >> i : 1, h = im->h >> i ? im->h >> i : 1, bx = (w + f->bw - 1) / f->bw, by = (h + f->bh - 1) / f->bh;
+        VkDeviceSize per = (VkDeviceSize)bx * by * 16;
+        if (per > CA_LAYER_MAX) { g_cas.lv++; g_cas.ly = 0; continue; }
+        while (g_cas.ly < im->layers && !ca_bound(im, i, g_cas.ly, h)) { g_cas.ly++; g_cas.unread++; }
+        if (g_cas.ly >= im->layers) { g_cas.lv++; g_cas.ly = 0; continue; }
+        if (used + per > CA_ARENA) break;   // the next submission goes on here
+        VkBufferImageCopy rg[64]; uint32_t n = 0, ly0 = g_cas.ly;
+        while (g_cas.ly < im->layers && n < 64 && used + (n + 1) * per <= CA_ARENA && ca_bound(im, i, g_cas.ly, h)) {
+            rg[n] = (VkBufferImageCopy){b->mem.off + used + n * per, 0, 0, {VK_IMAGE_ASPECT_COLOR_BIT, i, g_cas.ly, 1}, {0, 0, 0}, {w, h, 1}}; n++; g_cas.ly++; }
+        if (!barrier) { vka_barrier(cb); barrier = 1; }
+        memset(b->mem.ptr + used, 0xA5, 16);   // (still there when the batch is read: the copy never ran, the record is not counted)
+        vk.vkCmdCopyImageToBuffer(cb, im->img, VK_IMAGE_LAYOUT_GENERAL, b->mem.buf, n, rg);
+        b->r[b->n++] = (ca_rec){im->serial, (uint32_t)im->d.format, (uint32_t)im->d.width, (uint32_t)im->d.height, im->layers, i + im->base, w, h, ly0, n, bx * by, f->bw, f->bh,
+                                (im->gpu_owned ? 1u : 0) | (im->wt ? 2u : 0) | (im->rs ? 4u : 0) | (im->vtrack ? 8u : 0) | (im->dcap ? 16u : 0), used};
+        used += n * per;
