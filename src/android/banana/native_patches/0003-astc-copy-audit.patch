+// The copy audit's ASTC check (DM_VK_COPY_AUDIT, vka_tex.c; once a run): twelve blocks of a 16x12 ASTC 4x4 texture as the device samples them, logged when fence is
+// done. The blocks reach the image as they are (a copy after the texture's own, cleaned upload): the kinds an upload takes out, and void-extent blocks with an extent
+int hk_astc_probe_blocks(uint8_t out[2][16], float first[2][4]);   // vka_astc_hdr.cpp
+static struct { vka_span out; float exp[12][4]; int know[12]; const char *what[12]; } g_pr;   // know: 1 = exp is what a decoder reads, 2 = exp is the block's colour
+static void probe_report(void *arg) {
+    (void)arg; const float *t = (const float *)g_pr.out.ptr;
+    for (int b = 0; b < 12; b++) {
+        if (!g_pr.what[b]) continue;
+        const float *v = t + 4 * ((b / 4) * 4 * 16 + (b % 4) * 4);   // the block's first texel in the 16x12 texture
+        int err = v[0] > 0.99f && v[1] < 0.01f && v[2] > 0.99f && v[3] > 0.99f; char e[96] = "";
+        if (g_pr.know[b]) snprintf(e, sizeof e, "; %s (%.3f, %.3f, %.3f, %.3f)", g_pr.know[b] == 1 ? "a decoder of the full profile reads" : "its colour is", g_pr.exp[b][0], g_pr.exp[b][1], g_pr.exp[b][2], g_pr.exp[b][3]);
+        VLOG("copy audit: ASTC check: %s samples as (%.3f, %.3f, %.3f, %.3f)%s%s", g_pr.what[b], v[0], v[1], v[2], v[3], err ? ": the error colour" : "", e);
+    }
+}
+static void probe_ve(uint8_t *b, int hdr, int rsv, uint32_t s0, uint32_t s1, uint32_t t0, uint32_t t1, const uint16_t c[4]) {   // a void-extent block
+    uint64_t lo = 0x1fc | (uint64_t)hdr << 9 | (uint64_t)rsv << 10 | (uint64_t)s0 << 12 | (uint64_t)s1 << 25 | (uint64_t)t0 << 38 | (uint64_t)t1 << 51, hi = 0;
+    for (int k = 0; k < 4; k++) hi |= (uint64_t)c[k] << (16 * k);
+    memcpy(b, &lo, 8); memcpy(b + 8, &hi, 8);
+}
+void vka_astc_probe(VkCommandBuffer cb, uint64_t fence) {
+    static int done; if (done) return;
+    done = 1;
+    static uint8_t blk[12][16]; static tex_t t; vka_span raw;
+    if (!ready() || !vka_static(sizeof blk, 16, &raw) || !vka_static(192 * 16, V.sb_align, &g_pr.out)) { VLOG("copy audit: ASTC check: not run (push descriptors or memory)"); return; }
+    static const uint16_t C[4] = {0x8000, 0x4000, 0xc000, 0xffff}, H[4] = {0x3800, 0x3400, 0x3a00, 0x3c00}, Z[4] = {0, 0, 0, 0};
+    static const float ec[4] = {0.5f, 0.25f, 0.75f, 1.0f};
+    memset(blk, 0, sizeof blk);
+    probe_ve(blk[0], 0, 3, 0x1fff, 0x1fff, 0x1fff, 0x1fff, C); g_pr.what[0] = "an LDR void-extent block without an extent";
+    probe_ve(blk[1], 0, 3, 0, 0, 0, 0, C); g_pr.what[1] = "an LDR void-extent block whose extent is all zero (illegal)";
+    probe_ve(blk[2], 0, 3, 0, 0x1000, 0, 0x1000, C); g_pr.what[2] = "an LDR void-extent block with a legal extent";
+    probe_ve(blk[3], 0, 3, 0x1000, 0x800, 0, 0x1000, C); g_pr.what[3] = "an LDR void-extent block whose extent has low above high (illegal)";
+    g_pr.what[4] = "an all-zero block";
+    probe_ve(blk[5], 1, 3, 0x1fff, 0x1fff, 0x1fff, 0x1fff, H); g_pr.what[5] = "an HDR void-extent block";
+    probe_ve(blk[6], 0, 0, 0x1fff, 0x1fff, 0x1fff, 0x1fff, C); g_pr.what[6] = "a void-extent block with its reserved bits clear (illegal)";
+    probe_ve(blk[7], 0, 3, 0x1fff, 0x1fff, 0x1fff, 0x1fff, Z); g_pr.what[7] = "the zero texels an upload makes (an LDR void-extent block of 0)";
+    for (int b = 0; b < 7; b++) if (b != 4) { memcpy(g_pr.exp[b], ec, sizeof ec); g_pr.know[b] = b == 1 || b == 3 || b == 6 ? 2 : 1; }   // (the illegal ones: an error block by the specification)
+    uint8_t two[2][16]; float first[2][4]; int pr = hk_astc_probe_blocks(two, first);
+    if (pr & 1) { memcpy(blk[8], two[0], 16); memcpy(g_pr.exp[8], first[0], sizeof first[0]); g_pr.know[8] = 1; g_pr.what[8] = "a block of LDR endpoint modes"; }
+    if (pr & 2) { memcpy(blk[9], two[1], 16); memcpy(g_pr.exp[9], first[1], sizeof first[1]); g_pr.know[9] = 1; g_pr.what[9] = "a block of an HDR endpoint mode"; }
+    for (int b = 8; b < 12; b++) if (!g_pr.what[b]) memcpy(blk[b], blk[7], 16);
+    memset(&t, 0, sizeof t);
+    t.d.target = NVN_TEXTURE_TARGET_2D; t.d.format = 0x79; t.d.width = 16; t.d.height = 12; t.d.depth = 1; t.d.levels = 1; t.d.flags = NVN_TEXTURE_FLAGS_LINEAR; t.d.stride = 64;
+    nvn_tex_layout(&t.d, &t.L); t.mem = (uint8_t *)blk; t.serial = nvn_new_serial();
