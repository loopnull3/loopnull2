+++ b/dm/gfx/vk_android/vka_astc_hdr.cpp
@@ -5,6 +5,7 @@
 // encoded again with the LDR one (astcenc, dm/third_party/astcenc, Apache-2.0), in place
 #include "astcenc.h"
 #include <cstdint>
+#include <cstdio>
 #include <cstring>
 #include <mutex>
 #include <vector>
@@ -156,6 +157,99 @@ extern "C" double hk_astc_bad_share(const uint8_t *data, size_t n, unsigned bw,
     return n ? (double)bad / (double)n : 0.0;
 }
 
+// A census of n blocks by their headers, added to out (a diagnostic, vka_tex.c "Copy audit"): [0] all-zero blocks, [1] blocks no decoder reads, [2] HDR void-extent
+// blocks, [3] LDR void-extent blocks without an extent (its coordinates all ones), [4] blocks with an HDR endpoint mode, [5] LDR void-extent blocks with an extent,
+// [6] LDR void-extent blocks whose extent is illegal (a low coordinate not below its high one: an error block by the specification)
+extern "C" void hk_astc_count(const uint8_t *data, size_t n, unsigned bw, unsigned bh, uint32_t out[7]) {
+    static const uint8_t zero16[16] = {0};
+    for (size_t i = 0; i < n; i++) {
+        const uint8_t *b = data + 16 * i; bool ve = b[0] == 0xFC && (b[1] & 1);
+        if (!memcmp(b, zero16, 16)) out[0]++;
+        else if (surely_bad(b, bw, bh)) out[1]++;
+        else if (maybe_hdr(b)) out[ve ? 2 : 4]++;
+        else if (ve) {
+            uint64_t lo; memcpy(&lo, b, 8);
+            uint64_t e = lo >> 12; uint32_t s0 = e & 0x1FFF, s1 = (e >> 13) & 0x1FFF, t0 = (e >> 26) & 0x1FFF, t1 = (e >> 39) & 0x1FFF;
+            out[e == 0xFFFFFFFFFFFFFull ? 3 : s0 >= s1 || t0 >= t1 ? 6 : 5]++;
+        }
+    }
+}
+
+// Two blocks of 4x4 texels for the device's ASTC check (vka_nanscan.c vka_astc_probe), of one gradient within [0, 1]: out[0] with LDR endpoint modes, out[1] with an
+// HDR endpoint mode; first[k]: block k's first texel as astcenc decodes it. → bit 0: made, bit 1: out[1] has an HDR endpoint mode
+extern "C" int hk_astc_probe_blocks(uint8_t out[2][16], float first[2][4]) {
+    std::lock_guard<std::mutex> lock(g_mu);
+    astcenc_context *c[2] = {make(ASTCENC_PRF_LDR, 4, 4, 0, ASTCENC_PRE_FAST), make(ASTCENC_PRF_HDR, 4, 4, 0, ASTCENC_PRE_FAST)};
+    const astcenc_swizzle swz = {ASTCENC_SWZ_R, ASTCENC_SWZ_G, ASTCENC_SWZ_B, ASTCENC_SWZ_A};
+    int ok = c[0] && c[1];
+    for (int k = 0; k < 2 && ok; k++) {
+        float px[16 * 4], dec[16 * 4];
+        for (int i = 0; i < 16; i++) { px[4 * i] = 0.2f + 0.04f * (float)(i % 4); px[4 * i + 1] = 0.6f - 0.03f * (float)(i / 4); px[4 * i + 2] = 0.3f + 0.02f * (float)(i % 4 + i / 4); px[4 * i + 3] = 1.0f; }
+        void *slice = px, *dslice = dec;
+        astcenc_image img = {4, 4, 1, ASTCENC_TYPE_F32, &slice}, dimg = {4, 4, 1, ASTCENC_TYPE_F32, &dslice};
+        ok = astcenc_compress_image(c[k], &img, &swz, out[k], 16, 0) == ASTCENC_SUCCESS && astcenc_decompress_image(c[1], out[k], 16, &dimg, &swz, 0) == ASTCENC_SUCCESS;
+        memcpy(first[k], dec, 4 * sizeof(float));
+    }
+    for (astcenc_context *x : c) if (x) astcenc_context_free(x);
+    return ok ? 1 | (maybe_hdr(out[1]) && !surely_bad(out[1], 4, 4) ? 2 : 0) : 0;
+}
+
+// The copy audit's reference decoder (vka_tex.c "Copy audit"): astcenc with the LDR profile, which reads an error block and a block of the HDR profile as the error
+// colour (1, 0, 1, 1), as a driver without the HDR profile does. One context a block size, kept
+static astcenc_context *ldr_dec(unsigned bw, unsigned bh) {   // (g_mu held)
+    static astcenc_context *c[13][13]; static bool tried[13][13];
+    if (bw < 4 || bw > 12 || bh < 4 || bh > 12) return nullptr;
+    if (!tried[bw][bh]) { tried[bw][bh] = true; c[bw][bh] = make(ASTCENC_PRF_LDR, bw, bh, ASTCENC_FLG_DECOMPRESS_ONLY, ASTCENC_PRE_FASTEST); }
+    return c[bw][bh];
+}
+// A level of w x h texels (its blocks row by row) as the reference decodes it: out takes w * h RGBA floats, the stored values (sRGB-encoded for an sRGB texture); an
+// error block's texels are NaN, a block of the HDR profile's (1, 0, 1, 1). 1 = done
+extern "C" int hk_astc_decode(const uint8_t *data, unsigned w, unsigned h, unsigned bw, unsigned bh, float *out) {
+    std::lock_guard<std::mutex> lock(g_mu);
+    astcenc_context *c = ldr_dec(bw, bh);
+    if (!c) return 0;
+    const astcenc_swizzle swz = {ASTCENC_SWZ_R, ASTCENC_SWZ_G, ASTCENC_SWZ_B, ASTCENC_SWZ_A};
+    void *slice = out; astcenc_image img = {w, h, 1, ASTCENC_TYPE_F32, &slice};
+    size_t n = (size_t)((w + bw - 1) / bw) * ((h + bh - 1) / bh);
+    int ok = astcenc_decompress_image(c, data, 16 * n, &img, &swz, 0) == ASTCENC_SUCCESS;
+    astcenc_decompress_reset(c);
+    return ok;
+}
+// Of n blocks, every step-th: → how many the reference decoder reads as error blocks or blocks of the HDR profile (magenta on a driver without that profile);
+// *seen: how many were looked at; mean: the mean colour of up to 64 of the blocks, evenly spaced, as the reference decodes them (0..1, the stored values)
+extern "C" uint32_t hk_astc_look(const uint8_t *data, size_t n, unsigned bw, unsigned bh, unsigned step, uint32_t *seen, float mean[4]) {
+    std::lock_guard<std::mutex> lock(g_mu);
+    astcenc_context *c = ldr_dec(bw, bh); uint32_t bad = 0, ns = 0;
+    mean[0] = mean[1] = mean[2] = mean[3] = 0;
+    if (!c || !n) { if (seen) *seen = 0; return 0; }
+    if (!step) step = 1;
+    for (size_t i = 0; i < n; i += step) { astcenc_block_info bi; ns++; if (astcenc_get_block_info(c, data + 16 * i, &bi) != ASTCENC_SUCCESS || bi.is_error_block || maybe_hdr(data + 16 * i)) bad++; }   // (the LDR profile reports no HDR block: by the header)
+    if (seen) *seen = ns;
+    size_t k = n < 64 ? n : 64; std::vector<uint8_t> blocks(16 * k); std::vector<float> px(k * bw * bh * 4);
+    for (size_t j = 0; j < k; j++) memcpy(&blocks[16 * j], data + 16 * (j * n / k), 16);
+    const astcenc_swizzle swz = {ASTCENC_SWZ_R, ASTCENC_SWZ_G, ASTCENC_SWZ_B, ASTCENC_SWZ_A};
+    void *slice = px.data(); astcenc_image img = {unsigned(k * bw), bh, 1, ASTCENC_TYPE_F32, &slice};   // the blocks side by side
+    if (astcenc_decompress_image(c, blocks.data(), blocks.size(), &img, &swz, 0) == ASTCENC_SUCCESS) {
+        double s[4] = {0, 0, 0, 0}; size_t nt = k * bw * bh;
+        for (size_t t = 0; t < nt; t++) for (int q = 0; q < 4; q++) { float v = px[4 * t + q]; s[q] += v > 0.0f ? (v < 1.0f ? v : 1.0f) : 0.0f; }
+        for (int q = 0; q < 4; q++) mean[q] = (float)(s[q] / (double)nt);
+    }
+    astcenc_decompress_reset(c);
+    return bad;
+}
+// A block in words, for a log line: what the reference decoder says it is
+extern "C" void hk_astc_describe(const uint8_t *b, unsigned bw, unsigned bh, char *out, size_t n) {
+    std::lock_guard<std::mutex> lock(g_mu);
+    astcenc_context *c = ldr_dec(bw, bh); astcenc_block_info bi;
+    char hex[40]; for (int i = 0; i < 16; i++) snprintf(hex + 2 * i, 3, "%02x", b[i]);
+    if (!c || astcenc_get_block_info(c, b, &bi) != ASTCENC_SUCCESS) { snprintf(out, n, "%s (no reference decoder)", hex); return; }
+    if (bi.is_error_block) snprintf(out, n, "%s: an error block to the reference decoder%s", hex, surely_bad(b, bw, bh) ? " (by its header)" : " (its header passes)");
+    else if (bi.is_constant_block) snprintf(out, n, "%s: a void-extent block%s", hex, maybe_hdr(b) ? " (HDR)" : "");
+    else snprintf(out, n, "%s: %u partition(s), %s, weights %ux%u, endpoint modes %u %u %u %u%s", hex, bi.partition_count, bi.is_dual_plane_block ? "two planes" : "one plane", bi.weight_x, bi.weight_y,
+                  bi.color_endpoint_modes[0], bi.partition_count > 1 ? bi.color_endpoint_modes[1] : 0, bi.partition_count > 2 ? bi.color_endpoint_modes[2] : 0,
+                  bi.partition_count > 3 ? bi.color_endpoint_modes[3] : 0, maybe_hdr(b) ? " (an HDR endpoint mode)" : "");
+}
