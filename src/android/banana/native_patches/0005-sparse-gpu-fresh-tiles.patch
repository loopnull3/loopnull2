+// DM_VK_SPARSE_GPU_ZERO=1 (an experiment, Hokkaido): a GPU-written sparse texture's tile bound after its first use starts as zeros, as a page the game cleared or never
+// wrote reads on the Switch, instead of with what its memory slot last held (sparse_bind's open point: the content of whichever tile had the slot before)
+static uint32_t g_tzn;   // tiles zeroed by the bind in progress
+static void tile_zero(vka_img *im, VkCommandBuffer cb, uint32_t i, uint32_t ly, uint32_t tx, uint32_t ty, uint32_t w, uint32_t h) {
+    const vka_fmt *f = &im->f; uint32_t px0 = tx * im->rs_tw, py0 = ty * im->rs_th;
+    if (!cb || px0 >= w || py0 >= h || !zero_src()) return;
+    uint32_t px1 = px0 + im->rs_tw > w ? w : px0 + im->rs_tw, py1 = py0 + im->rs_th > h ? h : py0 + im->rs_th;
+    if ((uint64_t)((px1 - px0 + f->bw - 1) / f->bw) * ((py1 - py0 + f->bh - 1) / f->bh) * f->bpb > ZHALF) return;
+    VkBufferImageCopy rg = {is_astc(f->vk) ? ZHALF : 0, 0, 0, {im->aspect, i, ly, 1}, {(int32_t)px0, (int32_t)py0, 0}, {px1 - px0, py1 - py0, 1}};
+    vk.vkCmdCopyBufferToImage(cb, g_zbuf, im->img, VK_IMAGE_LAYOUT_GENERAL, 1, &rg);
+    g_tzn++;
+}
