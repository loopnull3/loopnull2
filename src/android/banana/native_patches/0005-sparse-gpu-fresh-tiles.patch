-                    b2 |= vks_tile(im->rs, i, ly, tx, k, po < off + len && nvn_sparse_any(im->vpool, mem + po, 0x10000));
+                    int fresh = bind_only && !all && VKA_ENV("DM_VK_SPARSE_GPU_ZERO", 0) > 0 && !vks_tile_bound(im->rs, i, ly, tx, k);   // (the experiment: a tile bound now)
+                    int on = vks_tile(im->rs, i, ly, tx, k, po < off + len && nvn_sparse_any(im->vpool, mem + po, 0x10000));
+                    b2 |= on;
+                    if (fresh && on) tile_zero(im, cb, i, ly, tx, k, w, h);
