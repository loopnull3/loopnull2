diff --git a/dm/gfx/vk_android/vka_tex.c b/dm/gfx/vk_android/vka_tex.c
index 9a3dd137..80a86a23 100644
--- a/dm/gfx/vk_android/vka_tex.c
+++ b/dm/gfx/vk_android/vka_tex.c
@@ -456,8 +456,13 @@ static uint32_t sparse_base(const void *pool, const uint8_t *mem, const nvn_texd
 }
 // A sparse residency image (vka_sparse.c) instead of a dense one: a sampled sparse pool texture, 2D or 2D array, single-sampled, with NVN tiled levels from base on, whose dense
 // image from base would take DM_VK_SPARSE_RES_MB (default 32) or more; or a GPU-written one (sparse_gpu) from level 0. Smaller ones stay dense (the tiles' bookkeeping and binds cost more than they save)
+// Not an ASTC texture (LoopNative, a candidate under test): Mario Kart World's road paint and ground are magenta at a distance on RADV for Samsung's Xclipse, the one
+// driver here with sparse residency for ASTC (the Adreno 840 has it for no block-compressed format, so upstream's ASTC arrays are dense images, their unmapped parts
+// uploaded as zero-texel blocks, k_astc_zero). Bytes of 0 are no ASTC data: a GPU decodes them to ASTC's error colour, magenta. DM_VK_SPARSE_RES_ASTC=1: residency
+// images again, to compare
 static int res_candidate(const tex_t *t, const vka_fmt *f, uint32_t base) {
     const nvn_texdesc *d = &t->d; uint32_t tw, th, td;
+    if (f->vk >= VK_FORMAT_ASTC_4x4_UNORM_BLOCK && f->vk <= VK_FORMAT_ASTC_12x12_SRGB_BLOCK && !VKA_ENV("DM_VK_SPARSE_RES_ASTC", 0)) return 0;
     if (!vks_on() || !(sparse_sampled(t, f) || (base == 0 && sparse_gpu(t, f))) || (d->target != NVN_TEXTURE_TARGET_2D && d->target != NVN_TEXTURE_TARGET_2D_ARRAY) || d->samples > 1) return 0;
     if (nvn_tex_sparse_tiles(d, &tw, &th, &td) <= (int)base || td != 1) return 0;
     uint64_t lo = nvn_tex_level_offset(d, base), ly = t->L.layer_size > lo ? t->L.layer_size - lo : 0;
