diff --git a/dm/gfx/vk_android/vka_tex.c b/dm/gfx/vk_android/vka_tex.c
index 499b713d..c2f37270 100644
--- a/dm/gfx/vk_android/vka_tex.c
+++ b/dm/gfx/vk_android/vka_tex.c
@@ -2824,6 +2824,18 @@ static VkComponentSwizzle swz1(int n) { return n >= 0 && n <= 5 ? (VkComponentSw
 // each drawn from the one above through a view of the whole chain; sampling the attached level is a feedback loop Vulkan leaves undefined (on Adreno: NaN texels, which bloom
 // spread into white blotches and black speckles over the whole level)
 static vka_img *g_fb_im[9]; static uint32_t g_fb_lv[9]; static int g_nfb;
+// DM_VK_ASTC_LEVEL_CAP=1 (an experiment, Hokkaido): the levels of an ASTC image, from its first, whose block count is the first level's halved (rounded down, at least 1).
+// The first that has more (85 texels are 11 blocks of 8, their half, 42, is 6) and those after it are left out of sampled views: RADV on Xclipse fills such a level
+// through a view of the image as an uncompressed format and samples it elsewhere (the copy audit's mip check)
+static uint32_t astc_exact_levels(const vka_img *im) {
+    if (!is_astc(im->f.vk) || VKA_ENV("DM_VK_ASTC_LEVEL_CAP", 0) <= 0) return im->levels;
+    uint32_t bw = im->f.bw, bh = im->f.bh, bx0 = (im->w + bw - 1) / bw, by0 = (im->h + bh - 1) / bh;
+    for (uint32_t i = 1; i < im->levels; i++) {
+        uint32_t w = im->w >> i ? im->w >> i : 1, h = im->h >> i ? im->h >> i : 1;
+        if ((bx0 >> i ? bx0 >> i : 1) < (w + bw - 1) / bw || (by0 >> i ? by0 >> i : 1) < (h + bh - 1) / bh) return i;
+    }
+    return im->levels;
+}
 void vka_tex_feedback(vka_img *const *ims, const uint32_t *levels, int n) { g_nfb = n > 9 ? 9 : n; for (int i = 0; i < g_nfb; i++) { g_fb_im[i] = ims[i]; g_fb_lv[i] = levels[i]; } }
 static VkImageView view_of(const treg_ent *e, vka_img *im, int vt_want, int storage, VkFormat ovr) {
     vka_fmt f; const view_t *v = e->has_v ? &e->v : NULL;
@@ -2837,6 +2849,14 @@ static VkImageView view_of(const treg_ent *e, vka_img *im, int vt_want, int stor
     if (l0 >= im->levels || a0 >= im->layers) return VK_NULL_HANDLE;
     if (l0 + nl > im->levels) nl = im->levels - l0;
     if (a0 + na > im->layers) na = im->layers - a0;
+    if (!storage) {   // (DM_VK_ASTC_LEVEL_CAP)
+        uint32_t cap = astc_exact_levels(im);
+        if (cap < im->levels) {
+            static _Atomic int n; if (l0 + nl > cap && atomic_fetch_add(&n, 1) < 48) VLOG("ASTC texture serial %llu %ux%u x%u format %#x: sampled through its first %u of %u levels (DM_VK_ASTC_LEVEL_CAP)",
+                                                                                         (unsigned long long)im->serial, im->w, im->h, im->layers, im->d.format, cap, im->levels);
+            if (l0 >= cap) { l0 = cap - 1; nl = 1; } else if (l0 + nl > cap) nl = cap - l0;
+        }
+    }
     if (vt_want >= 0 && !storage) for (int i = 0; i < g_nfb; i++) if (g_fb_im[i] == im && g_fb_lv[i] > l0 && g_fb_lv[i] < l0 + nl) {
         static _Atomic int n; if (!atomic_exchange(&n, 1)) VLOG("a pass samples the texture it renders (serial %llu level %u) through levels %u+%u: sampled through the levels below it", (unsigned long long)im->serial, g_fb_lv[i], l0, nl);
         nl = g_fb_lv[i] - l0; }
@@ -3890,4 +3910,38 @@ void vka_caud_scan(VkCommandBuffer cb, uint64_t fence) {
     atomic_store(&b->busy, 1);
     vka_after(fence, ca_scan_report, b);
 }
+// DM_VK_ASTC_T2T_CPU=1 (an experiment, Hokkaido): a texture → texture copy out of an ASTC texture whose image follows its guest storage is made from that storage: the
+// source level's block rows deswizzled into scratch memory, cleaned as an upload's, and copied into the destination. The image is not read: RADV on Xclipse reads a
+// level of an ASTC image whose size is no power of two elsewhere than it samples it (the copy audit's mip check), and Mario Kart World fills its terrain arrays by
+// such copies. tsl: the source's texture level; dil: the destination's image level. 1 = done; 0 = not such a copy, or not readable (the caller copies image to image)
+int vka_astc_t2t_cpu(vka_img *s, vka_img *d, uint32_t tsl, uint32_t sz, uint32_t dil, uint32_t dz, uint32_t nz, int sx, int sy, int dx, int dy, int w, int h, VkCommandBuffer cb) {
+    if (VKA_ENV("DM_VK_ASTC_T2T_CPU", 0) <= 0 || !is_astc(s->f.vk) || !is_astc(d->f.vk) || s->f.bw != d->f.bw || s->f.bh != d->f.bh) return 0;
+    if (s->gpu_owned || !s->mem || s->vpool || s->par || s->is_video || s->samples > 1 || s->depth > 1 || s->d.target == NVN_TEXTURE_TARGET_3D || (s->d.flags & NVN_TEXTURE_FLAGS_LINEAR)) return 0;
+    const vka_fmt *f = &s->f; uint32_t lw = s->d.width >> tsl ? s->d.width >> tsl : 1, lh = s->d.height >> tsl ? s->d.height >> tsl : 1;
+    uint32_t lbx = (lw + f->bw - 1) / f->bw, lby = (lh + f->bh - 1) / f->bh;
+    if (tsl >= (s->d.levels ? s->d.levels : 1) || sz + nz > s->layers || sx < 0 || sy < 0 || w <= 0 || h <= 0 || (uint32_t)sx % f->bw || (uint32_t)sy % f->bh ||
+        (uint32_t)sx + (uint32_t)w > lw || (uint32_t)sy + (uint32_t)h > lh) return 0;
+    uint32_t bx0 = (uint32_t)sx / f->bw, by0 = (uint32_t)sy / f->bh, nby = ((uint32_t)h + f->bh - 1) / f->bh; size_t pitch = (size_t)lbx * f->bpb;
+    if (by0 + nby > lby) return 0;
+    tex_t t = {0}; t.serial = s->serial; t.d = s->d; t.L = s->L; t.mem = (uint8_t *)s->mem;
+    int ok = 1; uint32_t done = 0;
+    nvn_pool_use(1); pthread_mutex_lock(&g_tmu);   // (the storage is read: no pool is finalized under it; taken before g_tmu, as vka_tex_prepare does)
+    if (img_pool_dead(s)) ok = 0;
+    uint8_t *c = ok ? unmapped_content(&t) : NULL;   // (pages the guest has not mapped: zeros, in a copy)
+    for (uint32_t z = 0; z < nz && ok; z++) {
+        vka_span sp;
+        if (!vka_scratch((VkDeviceSize)nby * pitch, 16, &sp) || nvn_deswizzle_rows(&t.d, tsl, sz + z, c ? c : t.mem, sp.ptr - (size_t)by0 * pitch, pitch, by0, by0 + nby)) { ok = 0; break; }
+        astc_clean(f->vk, sp.ptr, (size_t)nby * pitch);
+        VkBufferImageCopy rg = {sp.off + (VkDeviceSize)bx0 * f->bpb, lbx * f->bw, nby * f->bh, {VK_IMAGE_ASPECT_COLOR_BIT, dil, dz + z, 1}, {dx, dy, 0}, {(uint32_t)w, (uint32_t)h, 1}};
+        vk.vkCmdCopyBufferToImage(cb, sp.buf, d->img, VK_IMAGE_LAYOUT_GENERAL, 1, &rg);
+        done++;
+    }
+    free(c);
+    pthread_mutex_unlock(&g_tmu); nvn_pool_use(0);
+    if (ok) { static _Atomic uint64_t n; uint64_t k = atomic_fetch_add(&n, nz) + nz; if (k == nz || !(k & (k - 1)))
+        VLOG("ASTC copies from the source's storage: %llu so far (DM_VK_ASTC_T2T_CPU; this one serial %llu level %u → serial %llu, %dx%d texels)", (unsigned long long)k, (unsigned long long)s->serial, tsl,
+             (unsigned long long)d->serial, w, h); }
+    (void)done;
+    return ok;
+}
 #endif
